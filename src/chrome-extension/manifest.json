{
  "manifest_version": 3,
  "name": "Xpedia — Tweet Corpus Builder",
  "version": "0.1.0",
  "description": "Capture your X bookmarks into a structured knowledge corpus.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://xpedia-five.vercel.app/*",
    "https://izmziwdtpqzcwchlfbik.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/i/bookmarks*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xpedia"
  },
  "icons": {}
}
